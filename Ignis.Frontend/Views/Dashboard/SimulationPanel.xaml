<UserControl x:Class="Ignis.Frontend.Views.Dashboard.SimulationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="300"
             Width="300">

    <UserControl.Resources>
        <!-- Tombol tutup: datar, hanya berubah warna saat disorot -->
        <Style x:Key="PanelCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="Transparent">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelActionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FFEDD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="16"
            Padding="14,12"
            Visibility="{Binding IsSimulationPanelVisible, Converter={StaticResource B2V}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.12" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Vertical">

            <!-- Judul + tombol tutup -->
            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SIMULASI PENYEBARAN API" FontSize="11" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource PanelCloseButton}" HorizontalAlignment="Right"
                        Command="{Binding CloseSimulationCommand}" ToolTip="Tutup simulasi"/>
            </Grid>

            <TextBlock Text="{Binding SimulationTargetText}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <!-- Sedang memuat -->
            <StackPanel Visibility="{Binding IsSimulationLoading, Converter={StaticResource B2V}}" Margin="0,0,0,4">
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="#F97316" Background="#FFEDD5" BorderThickness="0"/>
                <TextBlock Text="Memuat simulasi dari server…" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Gagal memuat -->
            <Border Visibility="{Binding HasSimulationError, Converter={StaticResource B2V}}"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="10,8">
                <TextBlock Text="{Binding SimulationError}" FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap"/>
            </Border>

            <!-- Hasil simulasi -->
            <StackPanel Visibility="{Binding HasSimulation, Converter={StaticResource B2V}}">

                <!-- Kompas arah rambatan + keterangan angin -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="78" Height="78" Margin="0,0,12,0" ToolTip="Panah = arah rambatan api">
                        <Ellipse Fill="#F8FAFC" Stroke="#CBD5E1" StrokeThickness="1.5"/>
                        <TextBlock Text="U" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        <TextBlock Text="B" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <TextBlock Text="T" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Canvas Width="78" Height="78">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="{Binding WindArrowAngle}" CenterX="39" CenterY="39"/>
                            </Canvas.RenderTransform>
                            <Polygon Points="39,13 48,35 42,33 42,56 36,56 36,33 30,35" Fill="#EA580C"/>
                        </Canvas>
                        <Ellipse Width="7" Height="7" Fill="#FFFFFF" Stroke="#EA580C" StrokeThickness="2"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SimulationSpreadText}" FontSize="12" FontWeight="Bold" Foreground="#C2410C" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SimulationWindText}" FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding SimulationConditionsText}" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Luas dan jumlah sel pada jam yang sedang ditampilkan -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SimulationAreaText}" FontSize="22" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding SimulationCellsText}" FontSize="10.5" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SimulationHourText}" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SimulationTimeText}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Grafik luas terbakar per jam; garis hitam = jam sekarang -->
                <Border Background="#FFF7ED" CornerRadius="8" Width="264" Height="52" HorizontalAlignment="Left" ClipToBounds="True">
                    <Canvas Width="264" Height="52" ClipToBounds="True">
                        <Polygon Points="{Binding AreaChartFillPoints}" Fill="#FDBA74" Opacity="0.55"/>
                        <Polyline Points="{Binding AreaChartLinePoints}" Stroke="#EA580C" StrokeThickness="2" StrokeLineJoin="Round"/>
                        <Line X1="{Binding AreaChartMarkerX}" X2="{Binding AreaChartMarkerX}" Y1="0" Y2="52" Stroke="#0F172A" StrokeThickness="1.5"/>
                    </Canvas>
                </Border>
                <Grid Width="264" HorizontalAlignment="Left" Margin="0,2,0,8">
                    <TextBlock Text="0 jam" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                    <TextBlock Text="luas terbakar per jam" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SimulationMaxHours, StringFormat='{}{0:0} jam'}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Legenda warna sel di peta -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical">
                        <Rectangle Width="120" Height="8" RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FDE047" Offset="0"/>
                                    <GradientStop Color="#F97316" Offset="0.5"/>
                                    <GradientStop Color="#991B1B" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Grid Width="120" Margin="0,2,0,0">
                            <TextBlock Text="baru menyala" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                            <TextBlock Text="lama terbakar" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Panah biru di peta = arah rambatan" FontSize="9.5" Foreground="#64748B"
                               TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>

                <TextBlock Text="{Binding SimulationLimitText}" FontSize="10" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="{Binding ShowSimulationLimit, Converter={StaticResource B2V}}"/>

                <TextBlock Text="Simulasi ilustratif (tanpa data lahan dan medan), bukan prakiraan operasional."
                           FontSize="9.5" FontStyle="Italic" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button Content="Lihat detail hotspot" Style="{StaticResource PanelActionButton}" Click="OpenDetail_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
