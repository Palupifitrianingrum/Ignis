<UserControl x:Class="Ignis.Frontend.Views.Shared.IconTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ignis.Frontend.Views.Shared"
             mc:Ignorable="d" 
             x:Name="Root"
             HorizontalAlignment="Center"
             Width="230"
             Height="50">
    <Border Background="#D9D9D9" CornerRadius="6" Padding="10,6" Width="230" Height="35">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Image Source="/Resources/Icons/user-svgrepo-com.png" Height="20" Width="20"/>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                           FontSize="14"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Margin="5,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InputText, ElementName=Root}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBox Text="{Binding InputText, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         FontSize="14"
                         VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
