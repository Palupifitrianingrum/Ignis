<UserControl x:Class="IgnisAdmin.Controls.StatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
        <StackPanel>
            <Border x:Name="Bar" Height="4" Width="36" CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock x:Name="LText" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="VText" Style="{StaticResource Num}" Text="0"/>
        </StackPanel>
    </Border>
</UserControl>
