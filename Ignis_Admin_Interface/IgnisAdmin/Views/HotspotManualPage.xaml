<UserControl x:Class="IgnisAdmin.Views.HotspotManualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IgnisAdmin.Controls">
    <DockPanel Margin="32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="+ Tambah Hotspot Manual" Style="{StaticResource Btn}" Click="Add_Click"/>
            <TextBlock Style="{StaticResource H1}" Text="Hotspot Manual"/>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-16,20">
            <c:StatCard x:Name="CTotal" Label="Total Hotspot Manual" Accent="#2E8B4A"/>
            <c:StatCard x:Name="CActive" Label="Masih Aktif" Accent="#E8531F"/>
            <c:StatCard x:Name="CDone" Label="Selesai Ditangani" Accent="#0F3B33"/>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Laporan Lapangan"/>
                <DataGrid x:Name="GridManual">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Koordinat" Binding="{Binding CoordText}" Width="170"/>
                        <DataGridTextColumn Header="Pelapor" Binding="{Binding ReportedBy}" Width="200"/>
                        <DataGridTextColumn Header="Waktu Kejadian" Binding="{Binding DetectedText}" Width="160"/>
                        <DataGridTextColumn Header="Catatan" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTemplateColumn Header="Aksi" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Detail" Style="{StaticResource BtnSmall}" Click="Detail_Click"/>
                                        <Button Content="Edit" Margin="6,0,0,0" Style="{StaticResource BtnSmall}" Click="Edit_Click"/>
                                        <Button Content="Hapus" Margin="6,0,0,0" Style="{StaticResource BtnSmall}" Click="Delete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
