<Window x:Class="IgnisAdmin.Views.HotspotFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IgnisAdmin.Controls"
        Title="Tambah Hotspot Manual" Width="1000" Height="680" WindowStartupLocation="CenterOwner"
        FontFamily="Poppins, Segoe UI" Background="{StaticResource Bg}">
    <StackPanel Margin="28,24">
        <TextBlock x:Name="TxtHeader" Style="{StaticResource H1}" Text="Tambah Hotspot Manual" Margin="0,0,0,16"/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Data Hotspot"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Latitude"/><TextBox x:Name="TxtLat"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Tingkat Keyakinan (%)"/><TextBox x:Name="TxtConf" Text="75"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Waktu Kejadian (tanggal)"/><DatePicker x:Name="DpDate"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Pelapor / Sumber Laporan"/><TextBox x:Name="TxtReporter"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Lbl}" Text="Longitude"/><TextBox x:Name="TxtLon"/>
                            <TextBlock Style="{StaticResource Lbl}" Text="Status"/>
                            <ComboBox x:Name="CmbStatus"><ComboBoxItem>Aktif</ComboBoxItem><ComboBoxItem>Dipantau</ComboBoxItem><ComboBoxItem>Selesai</ComboBoxItem></ComboBox>
                            <TextBlock Style="{StaticResource Lbl}" Text="Waktu Kejadian (jam, HH:mm)"/><TextBox x:Name="TxtTime"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Lbl}" Text="Catatan"/>
                    <TextBox x:Name="TxtNote" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Batal" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
                        <Button Content="Simpan Hotspot" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Pilih di Peta (klik untuk mengisi koordinat)"/>
                    <c:MapView x:Name="Map" Height="430"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Window>
