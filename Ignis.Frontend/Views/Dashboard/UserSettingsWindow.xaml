<Window x:Class="Ignis.Frontend.Views.Dashboard.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan — Ignis"
        Width="520" Height="660"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Poppins, Segoe UI"
        Background="{StaticResource Bg}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource H1}" FontSize="22" Text="Pengaturan"/>
            <TextBlock Style="{StaticResource Lbl}" Text="Ringkasan akun, tampilan peta, pembaruan data, keamanan, dan notifikasi." Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Ringkasan Profil & Akun -->
                <Border x:Name="ProfileCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Ringkasan Profil &amp; Akun"/>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Nama"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtProfileName" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Email"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtProfileEmail" Foreground="{StaticResource Ink}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Role"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtProfileRole" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Akun Google"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGoogleStatus" Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preferensi Tampilan Peta -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Preferensi Tampilan Peta"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Wilayah Fokus Default saat aplikasi dibuka"/>
                        <ComboBox x:Name="CmbDefaultRegion"/>

                        <CheckBox x:Name="ChkHideResolved"
                                  Content="Sembunyikan hotspot berstatus Resolved (padam)"
                                  Foreground="{StaticResource Ink}"
                                  FontSize="13"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pembaruan Data -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Pembaruan Data"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Auto-Refresh Data Hotspot di Peta"/>
                        <ComboBox x:Name="CmbAutoRefresh">
                            <ComboBoxItem Tag="0" Content="Manual (hanya saat dimuat ulang)"/>
                            <ComboBoxItem Tag="5" Content="Setiap 5 menit"/>
                            <ComboBoxItem Tag="15" Content="Setiap 15 menit"/>
                            <ComboBoxItem Tag="30" Content="Setiap 30 menit"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Keamanan Akun -->
                <Border x:Name="SecurityCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Keamanan Akun"/>
                        <TextBlock x:Name="LblCurrent" Style="{StaticResource Lbl}" Text="Password saat ini"/>
                        <PasswordBox x:Name="PwdCurrent"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Password baru (minimal 8 karakter)"/>
                        <PasswordBox x:Name="PwdNew"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Ulangi password baru"/>
                        <PasswordBox x:Name="PwdNew2"/>
                        <Button Content="Ganti Password" Style="{StaticResource BtnGhost}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="ChangePassword_Click"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Setelah diganti, perangkat lain yang sedang login akan keluar otomatis." Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Notifikasi -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Notifikasi"/>
                        <CheckBox x:Name="ChkNotif"
                                  Content="Tampilkan banner saat ada notifikasi api atau asap di dekat lokasi saya"
                                  Foreground="{StaticResource Ink}"
                                  FontSize="13"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Batal" Style="{StaticResource BtnGhost}" Click="Cancel_Click"/>
            <Button Content="Simpan" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
