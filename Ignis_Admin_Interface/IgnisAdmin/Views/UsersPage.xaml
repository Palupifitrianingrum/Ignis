<UserControl x:Class="IgnisAdmin.Views.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IgnisAdmin.Controls">
    <DockPanel Margin="32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16,8"><TextBlock Text="Admin" FontWeight="Medium"/></Border>
            <TextBlock Style="{StaticResource H1}" Text="Manajemen Pengguna"/>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-16,20">
            <c:StatCard x:Name="CTotal" Label="Total Pengguna" Accent="#0F3B33"/>
            <c:StatCard x:Name="CActive" Label="Pengguna Aktif" Accent="#2E8B4A"/>
            <c:StatCard x:Name="CInactive" Label="Pengguna Non-Aktif" Accent="#F28A1E"/>
            <c:StatCard x:Name="CAdmin" Label="Admin" Accent="#E8531F"/>
        </UniformGrid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Daftar dan Detail Pengguna"/>
                    <DataGrid x:Name="GridUsers">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                            <DataGridTemplateColumn Header="Aksi" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Detail" Style="{StaticResource BtnSmall}" Click="Detail_Click"/>
                                            <Button Content="Ubah Status" Margin="6,0,0,0" Style="{StaticResource BtnSmall}" Click="Toggle_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Filter Pengguna"/>
                        <TextBlock Style="{StaticResource Lbl}" Text="Role"/>
                        <ComboBox x:Name="CmbRole"><ComboBoxItem>Semua role</ComboBoxItem><ComboBoxItem>Admin</ComboBoxItem><ComboBoxItem>Terdaftar</ComboBoxItem></ComboBox>
                        <TextBlock Style="{StaticResource Lbl}" Text="Status"/>
                        <ComboBox x:Name="CmbStatus"><ComboBoxItem>Semua status</ComboBoxItem><ComboBoxItem>Aktif</ComboBoxItem><ComboBoxItem>Non-aktif</ComboBoxItem></ComboBox>
                        <Button Content="Terapkan" Style="{StaticResource Btn}" Click="Apply_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Aktivitas Terbaru"/>
                        <ItemsControl x:Name="LstAct">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
