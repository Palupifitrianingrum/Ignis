<Window x:Class="IgnisAdmin.Views.HotspotDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IgnisAdmin.Controls"
        Title="Detail Hotspot" Width="1020" Height="780" WindowStartupLocation="CenterOwner"
        FontFamily="Poppins, Segoe UI" Background="{StaticResource Bg}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Tutup" Style="{StaticResource BtnGhost}" Click="Close_Click"/>
                    <Button x:Name="BtnEdit" Content="Edit" Style="{StaticResource BtnAccent}" Margin="8,0,0,0" Click="Edit_Click"/>
                    <Button x:Name="BtnDel" Content="Hapus" Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Click="Delete_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtHeader" Style="{StaticResource H1}" Text="Detail Hotspot"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel><TextBlock Style="{StaticResource H2}" Text="Peta Lokasi"/><c:MapView x:Name="Map" Height="260"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Data Cuaca"/>
                            <UniformGrid Columns="2">
                                <c:InfoRow x:Name="WTemp" Label="Suhu" Margin="0,0,8,0"/>
                                <c:InfoRow x:Name="WHum" Label="Kelembapan" Margin="8,0,0,0"/>
                                <c:InfoRow x:Name="WWind" Label="Kecepatan Angin" Margin="0,0,8,0"/>
                                <c:InfoRow x:Name="WDir" Label="Arah Angin" Margin="8,0,0,0"/>
                                <c:InfoRow x:Name="WPres" Label="Tekanan" Margin="0,0,8,0"/>
                                <c:InfoRow x:Name="WRain" Label="Curah Hujan" Margin="8,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel><TextBlock Style="{StaticResource H2}" Text="Catatan / Keterangan"/><TextBlock x:Name="TxtNote" TextWrapping="Wrap" MinHeight="40"/></StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Informasi Lokasi"/>
                            <c:InfoRow x:Name="RId" Label="ID"/>
                            <c:InfoRow x:Name="RCoord" Label="Koordinat"/>
                            <c:InfoRow x:Name="RTime" Label="Waktu Deteksi"/>
                            <c:InfoRow x:Name="RConf" Label="Confidence"/>
                            <c:InfoRow x:Name="RBright" Label="Brightness"/>
                            <c:InfoRow x:Name="RSource" Label="Sumber"/>
                            <c:InfoRow x:Name="RStatus" Label="Status"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Prediksi Penyebaran Api"/>
                            <c:InfoRow x:Name="PDir" Label="Arah Rambatan"/>
                            <c:InfoRow x:Name="PSpeed" Label="Kecepatan"/>
                            <c:InfoRow x:Name="PArea" Label="Estimasi Luas"/>
                            <c:InfoRow x:Name="PHours" Label="Estimasi Waktu"/>
                            <c:InfoRow x:Name="PRisk" Label="Tingkat Risiko"/>
                            <Button Content="Hitung Ulang Prediksi" Style="{StaticResource BtnGhost}" Margin="0,4,0,0" Click="Recalc_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
