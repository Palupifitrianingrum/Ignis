<UserControl x:Class="Ignis.Frontend.Views.Admin.HotspotManualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Ignis.Frontend.Views.Admin.Controls">
    <DockPanel Margin="32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="+ Tambah Hotspot Manual" Style="{StaticResource Btn}" Click="Add_Click"/>
            <TextBlock Style="{StaticResource H1}" Text="Hotspot Manual"/>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-16,20">
            <c:StatCard x:Name="CTotal" Label="Total Hotspot Manual" Accent="#2E8B4A"/>
            <c:StatCard x:Name="CActive" Label="Masih Aktif" Accent="#E8531F"/>
            <c:StatCard x:Name="CDone" Label="Selesai Ditangani" Accent="#0F3B33"/>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="BtnDeleteSelected" DockPanel.Dock="Right" Content="Hapus Terpilih"
                            Style="{StaticResource BtnSmall}" Background="#DC2626" Foreground="#FFFFFF"
                            Visibility="Collapsed" Click="DeleteSelected_Click"/>
                    <TextBlock Style="{StaticResource H2}" Text="Laporan Lapangan" VerticalAlignment="Center" Margin="0"/>
                </DockPanel>
                <DataGrid x:Name="GridManual">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="ChkSelectAll" IsThreeState="False" Click="SelectAll_Click"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Pilih semua"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Click="RowCheck_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Koordinat" Binding="{Binding CoordText}" Width="170"/>
                        <DataGridTextColumn Header="Pelapor" Binding="{Binding ReportedBy}" Width="200"/>
                        <DataGridTextColumn Header="Waktu Kejadian" Binding="{Binding DetectedText}" Width="160"/>
                        <DataGridTextColumn Header="Catatan" Binding="{Binding Note}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTemplateColumn Header="Aksi" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Detail" Style="{StaticResource BtnSmall}" Click="Detail_Click"/>
                                        <Button Content="Edit" Margin="6,0,0,0" Style="{StaticResource BtnSmall}" Click="Edit_Click"/>
                                        <Button Content="Hapus" Margin="6,0,0,0" Style="{StaticResource BtnSmall}" Click="Delete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
