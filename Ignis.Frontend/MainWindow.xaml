<Window x:Class="Ignis.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ignis.Frontend"
        xmlns:dashboard="clr-namespace:Ignis.Frontend.Views.Dashboard"
        xmlns:admin="clr-namespace:Ignis.Frontend.Views.Admin"
        mc:Ignorable="d"
        Title="IGNIS - Wildfire Monitoring &amp; Prediction"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="1024"
        Background="#D8EEDC"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <!-- Esc membatalkan mode memilih lokasi di peta -->
        <KeyBinding Key="Escape" Command="{Binding CancelPickCommand}"/>
    </Window.InputBindings>

    <!-- Unified Dashboard Grid with Full Canvas and Overlay Drawer Sidebar -->
    <Grid Background="#D8EEDC">

        <!-- Layer 1: Map Canvas (Mapsui Native Map) -->
        <dashboard:MapCanvasPlaceholder/>

        <!-- Layer 3: Interactive Floating UI Overlays -->
        <Grid Margin="76,16,20,20">
            <Grid.RowDefinitions>
                <!-- Top Floating Area -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer / Center Map View -->
                <RowDefinition Height="*"/>
                <!-- Bottom Floating Widgets Area -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP FLOATING BAR -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Search Bar & Filter Chips -->
                <dashboard:TopSearchBar Grid.Column="0" HorizontalAlignment="Left"/>

                <!-- Right: Emergency Alert Badge + User Profile -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">

                    <!-- Lonceng notifikasi (pengguna terdaftar) -->
                    <dashboard:NotificationBell Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <!-- Emergency Alert Badge (Siaga Darurat Riau) -->
                    <Border Background="#FFF1EB"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="18"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Megaphone icon -->
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#EA580C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Data="M3 11l19-9-9 19-2-8-8-2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding EmergencyStatus}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#C2410C"/>
                        </StackPanel>
                    </Border>

                    <!-- User Profile -->
                    <Button x:Name="ProfileButton"
                            Command="{Binding ToggleProfileMenuCommand}"
                            Cursor="Hand"
                            ToolTip="Profil Pengguna &amp; Autentikasi"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="20" Background="{TemplateBinding Background}" Padding="4">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <!-- Plain Avatar Circle -->
                        <Border Width="38" Height="38" CornerRadius="19"
                                Background="#E2E8F0"
                                BorderBrush="#FFFFFF" BorderThickness="2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#64748B" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- NOTIFIKASI: panel daftar (dari lonceng) dan banner/petunjuk di atas peta -->
            <dashboard:NotificationPanel Grid.Row="1" Panel.ZIndex="90" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"/>
            <dashboard:NotificationToast Grid.Row="1" Panel.ZIndex="95" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>

            <!-- PROFILE DROPDOWN CARD (Appears below profile icon when logged in & clicked) -->
            <Border x:Name="ProfileMenuCard"
                    Grid.Row="1"
                    Panel.ZIndex="90"
                    Visibility="{Binding IsProfileMenuOpen, Converter={StaticResource B2V}}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    Width="250"
                    Background="#F1F5F9"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1.5"
                    CornerRadius="22"
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#000000"/>
                </Border.Effect>

                <StackPanel Orientation="Vertical">
                    <!-- Inner Grouped Box: Profile Pic + Account | Add Account | Log Out -->
                    <Border Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1.2"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <StackPanel Orientation="Vertical">

                            <!-- Row 1: Profile Pic | Account -->
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="1.2"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Profile Pic Circle -->
                                <Border Grid.Column="0"
                                        Width="38" Height="38"
                                        CornerRadius="19"
                                        Background="#E2E8F0"
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1.2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#64748B" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <!-- Vertical Divider -->
                                <Rectangle Grid.Column="1" Fill="#CBD5E1" VerticalAlignment="Stretch"/>

                                <!-- Account Label & User Name -->
                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="8,0">
                                    <TextBlock Text="Account"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding UserName}"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal Divider -->
                            <Rectangle Height="1.2" Fill="#CBD5E1"/>

                            <!-- Row 2: Add Account -->
                            <Button Command="{Binding AddAccountCommand}"
                                    Height="44"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="rowBorder" Background="{TemplateBinding Background}">
                                                        <TextBlock Text="Add Account"
                                                                   FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="#0F172A"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#F1F5F9"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Horizontal Divider -->
                            <Rectangle Height="1.2" Fill="#CBD5E1"/>

                            <!-- Row 3: Log Out -->
                            <Button Command="{Binding LogoutCommand}"
                                    Height="44"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="rowBorder" Background="{TemplateBinding Background}" CornerRadius="0,0,13,13">
                                                        <TextBlock x:Name="rowText"
                                                                   Text="Log Out"
                                                                   FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="#0F172A"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="rowBorder" Property="Background" Value="#FEE2E2"/>
                                                            <Setter TargetName="rowText" Property="Foreground" Value="#DC2626"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Admin Dashboard Button (Visible only for Admin role) -->
                    <Button Command="{Binding OpenAdminFromMenuCommand}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource B2V}}"
                            Height="42"
                            Margin="0,12,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0F3B33"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="adminBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="14">
                                                <TextBlock Text="Admin Dashboard"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="adminBorder" Property="Background" Value="#174D43"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Bottom Standalone Settings Button -->
                    <Button Command="{Binding OpenSettingsFromMenuCommand}"
                            Height="42"
                            Margin="0,10,0,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="settingsBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1.2"
                                                    CornerRadius="14">
                                                <TextBlock Text="Settings"
                                                           FontSize="14"
                                                           FontWeight="Medium"
                                                           Foreground="#0F172A"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="settingsBorder" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Bottom-Left: indeks bahaya kebakaran + pemutar simulasi -->
            <dashboard:FireRiskCard Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"/>

            <!-- Bottom-Right (di samping tombol peta): visualisasi simulasi penyebaran api -->
            <dashboard:SimulationPanel Grid.Row="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,64,0"/>

            <!-- BOTTOM FLOATING WIDGETS -->
            <!-- Bottom-Right: Map Control Buttons Stack -->
            <dashboard:MapControlsOverlay Grid.Row="2"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"/>

        </Grid>

        <!-- Layer 4: Auto-Hide Slide-Out Sidebar (Tucked to left wall, reveals on hover) -->
        <dashboard:SidebarNav Panel.ZIndex="100"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"/>

        <!-- Layer 5: Admin Dashboard (navigasi di dalam window yang sama) -->
        <admin:AdminDashboardView Panel.ZIndex="200"
                                  Visibility="{Binding IsAdminDashboardOpen, Converter={StaticResource B2V}}"/>

    </Grid>
</Window>
