<UserControl x:Class="Ignis.Frontend.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ignis.Frontend.Views.Auth"
             xmlns:shared="clr-namespace:Ignis.Frontend.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="#EBEBEB">
    <StackPanel Orientation="Vertical" Margin="24">

        <shared:IconTextBox Placeholder="Nama"
                            InputText="{Binding Name, Mode=TwoWay}"/>

        <shared:IconTextBox Placeholder="Email"
                            InputText="{Binding Email, Mode=TwoWay}"/>

        <shared:IconPasswordBox Placeholder="Password"
                                PasswordChanged="PasswordInput_PasswordChanged"/>

        <shared:IconPasswordBox Placeholder="Confirm Password"
                PasswordChanged="ConfirmPasswordInput_PasswordChanged"/>

        <shared:PrimaryButton Text="Register" Command="{Binding RegisterCommand}" Margin="0,15,0,0"/>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="Already have an account?"
                       Margin="0,10,0,0"/>

            <Button Content="Log in" 
                    Command="{Binding GoToLoginCommand}" 
                    Width="50"
                    Margin="0,10,0,0"
                    Background="Transparent"
                    Foreground="#0077B6"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>