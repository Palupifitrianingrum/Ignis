<UserControl x:Class="Ignis.Frontend.Views.Admin.Controls.IntegrationKeyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="TxtTitle" Style="{StaticResource Lbl}" FontWeight="Bold" Foreground="{StaticResource Ink}"/>

        <!-- Sumber dan topeng key yang sedang berlaku -->
        <Border x:Name="InfoBox" Background="#F6F4EF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,2,0,0">
            <StackPanel>
                <TextBlock x:Name="TxtSource" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtDetail" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtWarn" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Lbl}" Text="Key baru (kosong = tidak mengubah apa pun)"/>
        <PasswordBox x:Name="PwdNew" PasswordChanged="PwdNew_PasswordChanged"/>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="BtnTest" Content="Uji koneksi" Style="{StaticResource BtnGhost}" Click="Test_Click"
                    ToolTip="Menguji key yang diketik (atau key yang sedang berlaku bila kolom kosong) tanpa menyimpannya"/>
            <Button x:Name="BtnSave" Content="Simpan key" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Save_Click" IsEnabled="False"
                    ToolTip="Diuji dulu; hanya disimpan bila valid"/>
            <Button x:Name="BtnReset" Content="Kembalikan ke default" Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Click="Reset_Click" Visibility="Collapsed"
                    ToolTip="Buang key dari aplikasi sehingga key di file .env server dipakai lagi"/>
        </StackPanel>

        <TextBlock x:Name="TxtResult" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5"/>
    </StackPanel>
</UserControl>
