<UserControl x:Class="Ignis.Frontend.Views.Auth.LoginFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Ignis.Frontend.Views.Auth"
             xmlns:shared="clr-namespace:Ignis.Frontend.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <StackPanel Margin="24">
        
        <shared:GoogleLoginButton Command="{Binding LoginWithGoogleCommand}"
                                  Margin="10,0,0,16"/>

        <TextBlock Text="Or Sign in with Email"
                   FontSize="8"
                   Margin="10,4,0,20"
                   HorizontalAlignment="Center"/>

        <shared:IconTextBox Placeholder="Username"
                            InputText="{Binding Username, Mode=TwoWay}"
                            Margin="10,0,0,8"/>

        <shared:IconPasswordBox Placeholder="Password"
                                PasswordChanged="PasswordInput_PasswordChanged"
                                Margin="10,0,0,16"/>

        <shared:PrimaryButton Text="Login"
                              Command="{Binding LoginCommand}"
                              Margin="10, 0, 0, 16"/>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <TextBlock Text="Dont have an account?"/>
            <Button Content="Sign up" Command="{Binding GoToRegisterCommand}"
                    Width="50"
                    Background="Transparent"
                    Foreground="#0077B6"
                    BorderThickness="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
        </StackPanel>

        

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,8,8,8"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
