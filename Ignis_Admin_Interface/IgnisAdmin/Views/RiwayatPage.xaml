<UserControl x:Class="IgnisAdmin.Views.RiwayatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Ekspor CSV" Style="{StaticResource BtnGhost}" Click="Export_Click"/>
            <TextBlock Style="{StaticResource H1}" Text="Riwayat Prediksi"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18,8,18,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Tingkat Risiko"/>
                    <ComboBox x:Name="CmbRisk"><ComboBoxItem>Semua</ComboBoxItem><ComboBoxItem>LOW</ComboBoxItem><ComboBoxItem>MEDIUM</ComboBoxItem><ComboBoxItem>HIGH</ComboBoxItem><ComboBoxItem>CRITICAL</ComboBoxItem></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Dari"/><DatePicker x:Name="DpFrom"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Sampai"/><DatePicker x:Name="DpTo"/></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Button Content="Reset" Style="{StaticResource BtnGhost}" Click="Reset_Click"/>
                    <Button Content="Terapkan" Style="{StaticResource Btn}" Margin="8,0,0,0" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock x:Name="TxtCount" DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Hasil Prediksi"/>
                <DataGrid x:Name="GridPred">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Hotspot" Binding="{Binding HotspotId}" Width="80"/>
                        <DataGridTextColumn Header="Arah" Binding="{Binding DirectionText}" Width="70"/>
                        <DataGridTextColumn Header="Kecepatan" Binding="{Binding SpeedText}" Width="110"/>
                        <DataGridTextColumn Header="Luas" Binding="{Binding AreaText}" Width="90"/>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding HoursText}" Width="80"/>
                        <DataGridTextColumn Header="Risiko" Binding="{Binding RiskText}" Width="90" ElementStyle="{StaticResource RiskTag}"/>
                        <DataGridTextColumn Header="Dibuat" Binding="{Binding CreatedText}" Width="*"/>
                        <DataGridTemplateColumn Header="Aksi" Width="130">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Lihat Hotspot" Style="{StaticResource BtnSmall}" Click="View_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
