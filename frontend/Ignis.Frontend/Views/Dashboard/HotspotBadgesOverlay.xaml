<UserControl x:Class="Ignis.Frontend.Views.Dashboard.HotspotBadgesOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Canvas x:Name="OverlayCanvas" ClipToBounds="True">

        <!-- River & Landscape Text Watermarks (Matching Pelalawan Map in Hi-Fi) -->
        <TextBlock Canvas.Left="270" Canvas.Top="380"
                   Text="Pasar Pelalawan"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#335C67" Opacity="0.45"/>

        <TextBlock Canvas.Left="560" Canvas.Top="605"
                   Text="KP Ladang Kampar"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="#475569" Opacity="0.45"/>

        <TextBlock Canvas.Left="780" Canvas.Top="125"
                   Text="Masjid Al Iman"
                   FontSize="20" FontWeight="SemiBold"
                   Foreground="#64748B" Opacity="0.5"/>

        <!-- River label curve -->
        <TextBlock Canvas.Left="120" Canvas.Top="485"
                   Text="Kampar River"
                   FontSize="13" FontStyle="Italic" FontWeight="Medium"
                   Foreground="#3A7D8C" Opacity="0.6">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="-15"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <TextBlock Canvas.Left="600" Canvas.Top="415"
                   Text="Kampar River"
                   FontSize="13" FontStyle="Italic" FontWeight="Medium"
                   Foreground="#3A7D8C" Opacity="0.6">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="70"/>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- Fishing Spot (Purple Badge) -->
        <StackPanel Canvas.Left="720" Canvas.Top="410" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#A855F7" Width="28" Height="28" CornerRadius="14" Margin="0,0,8,0">
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path Stroke="#FFFFFF" StrokeThickness="2" Data="M12 2a5 5 0 0 1 5 5v3a5 5 0 0 1-10 0V7a5 5 0 0 1 5-5zM12 15v7M9 22h6"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="Spot mancing" FontSize="16" FontWeight="SemiBold" Foreground="#9333EA" Opacity="0.8" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ================= HOTSPOTS & HAZARD AURA ================= -->

        <!-- 1. Central Critical Hotspot Cluster (142 Titik Kritis) -->
        <!-- Outer Concentric Hazard Ring 1 -->
        <Ellipse Canvas.Left="380" Canvas.Top="300"
                 Width="140" Height="140"
                 Fill="#F97316" Opacity="0.12"/>

        <!-- Concentric Hazard Ring 2 -->
        <Ellipse Canvas.Left="405" Canvas.Top="325"
                 Width="90" Height="90"
                 Fill="#EF4444" Opacity="0.22"/>

        <!-- Center Flame Circle with "142" -->
        <Grid Canvas.Left="425" Canvas.Top="345" Width="50" Height="50" Cursor="Hand" ToolTip="Klaster Api Kritis: 142 Titik">
            <Ellipse Fill="#DC2626">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="12" Color="#DC2626" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                    <Path Fill="#FFFFFF" Data="M12 2C12 2 8 6.5 8 11.5C8 14 9.5 16 11 17C10.5 15.5 11 14 12 13C13 14 13.5 15.5 13 17C14.5 16 16 14 16 11.5C16 6.5 12 2 12 2z"/>
                </Viewbox>
                <TextBlock Text="142" FontSize="9" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Pill Label below cluster -->
        <Border Canvas.Left="380" Canvas.Top="398"
                Background="#1E293B" CornerRadius="12" Padding="10,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="#F26500" Margin="0,0,6,0"/>
                <TextBlock Text="142 Titik Kritis • FIRMS 98%" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>

        <!-- 2. Satgas Regu II & Patroli Pos 04 -->
        <Border Canvas.Left="370" Canvas.Top="340"
                Background="#1E293B" CornerRadius="8" Padding="6,4" Cursor="Hand" ToolTip="Tim Satgas Regu II">
            <StackPanel HorizontalAlignment="Center">
                <Viewbox Width="14" Height="14" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#FFFFFF" Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Satgas" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Regu II" FontSize="7" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Patroli Pos 04 • Aman (Green Shield Badge) -->
        <Border Canvas.Left="270" Canvas.Top="430"
                Background="#FFFFFF" CornerRadius="12" Padding="8,4" Cursor="Hand" ToolTip="Status Posko Patroli">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Green Shield Checkmark -->
                <Border Background="#16A34A" Width="16" Height="16" CornerRadius="8" Margin="0,0,6,0">
                    <Viewbox Width="10" Height="10">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#FFFFFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20 6L9 17l-5-5"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="Patroli Pos 04 • Aman" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
            </StackPanel>
        </Border>

        <!-- 3. Warning Alert: HS-0142 NASA 89% Conf -->
        <!-- Warning Triangle Circle -->
        <Border Canvas.Left="575" Canvas.Top="280"
                Background="#F59E0B" Width="38" Height="38" CornerRadius="19" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#F59E0B" Opacity="0.4"/>
            </Border.Effect>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Fill="#FFFFFF" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- Pill Label for NASA Alert -->
        <Border Canvas.Left="530" Canvas.Top="326"
                Background="#FFFFFF" CornerRadius="10" Padding="8,3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.1" Color="#000000"/>
            </Border.Effect>
            <TextBlock Text="HS-0142: NASA 89% Conf" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
        </Border>

        <!-- 4. Peat Fire: 38 MW • Gambut Terbakar -->
        <Border Canvas.Left="490" Canvas.Top="470"
                Background="#F97316" Width="36" Height="36" CornerRadius="18" Cursor="Hand" ToolTip="Kebakaran Lahan Gambut">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#F97316" Opacity="0.4"/>
            </Border.Effect>
            <Viewbox Width="16" Height="16">
                <Path Fill="#FFFFFF" Data="M12 2C12 2 8 6.5 8 11.5C8 14 9.5 16 11 17C10.5 15.5 11 14 12 13C13 14 13.5 15.5 13 17C14.5 16 16 14 16 11.5C16 6.5 12 2 12 2z"/>
            </Viewbox>
        </Border>

        <Border Canvas.Left="450" Canvas.Top="514"
                Background="#FFFFFF" CornerRadius="10" Padding="8,3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.1" Color="#000000"/>
            </Border.Effect>
            <TextBlock Text="38 MW • Gambut Terbakar" FontSize="10" FontWeight="Bold" Foreground="#1E293B"/>
        </Border>

    </Canvas>
</UserControl>
