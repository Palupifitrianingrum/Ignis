<UserControl x:Class="Ignis.Frontend.Views.Dashboard.NotificationToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- Banner notifikasi baru / hasil tindakan. Klik untuk membuka notifikasinya di peta. -->
        <Border Width="470" CornerRadius="14" Background="{Binding ToastBackgroundHex}" BorderBrush="{Binding ToastColorHex}" BorderThickness="1.5"
                Visibility="{Binding IsToastVisible, Converter={StaticResource B2V}}" Cursor="Hand">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenToastCommand}"/>
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{Binding ToastColorHex}" CornerRadius="12,0,0,12"/>
                <StackPanel Grid.Column="1" Margin="14,11,8,12">
                    <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Command="{Binding DismissToastCommand}" Width="24" Height="24" Margin="0,8,10,0"
                        VerticalAlignment="Top" Cursor="Hand" ToolTip="Tutup">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="12" Background="Transparent">
                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#14000000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Mode memilih lokasi di peta -->
        <Border Background="#0F3B33" CornerRadius="22" Padding="18,9,10,9" HorizontalAlignment="Center"
                Visibility="{Binding IsPickingLocation, Converter={StaticResource B2V}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📍 Klik lokasi Anda di peta (Esc untuk batal)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Content="Batal" Command="{Binding CancelPickCommand}" Margin="14,0,0,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#1F5A4F" CornerRadius="14" Padding="14,4">
                                <TextBlock Text="Batal" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#2A7566"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
