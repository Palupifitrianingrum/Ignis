<UserControl x:Class="IgnisAdmin.Controls.InfoRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
        <DockPanel>
            <TextBlock x:Name="VText" DockPanel.Dock="Right" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Right" Margin="12,0,0,0"/>
            <TextBlock x:Name="LText" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</UserControl>
