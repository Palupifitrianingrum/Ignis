<UserControl x:Class="Ignis.Frontend.Views.Dashboard.MapControlsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="60"
             Width="50">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

        <!-- 1. Target / Reticle Tool -->
        <Button Width="42" Height="42" Margin="0,0,0,10" Cursor="Hand" ToolTip="Ukur Area &amp; Radius">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="21" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <!-- Reticle / Crosshair Icon -->
                    <Path Stroke="#0F172A" StrokeThickness="2" StrokeStartLineCap="Round"
                          Data="M12 2v4m0 12v4M2 12h4m12 0h4m-6 0a4 4 0 1 1-8 0 4 4 0 0 1 8 0z"/>
                </Canvas>
            </Viewbox>
        </Button>

        <!-- 2. Compass (North indicator) -->
        <Button Command="{Binding ResetNorthCommand}"
                Width="42" Height="42" Margin="0,0,0,10" Cursor="Hand" ToolTip="Reset Rotasi Utara">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="21" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Red North Arrow -->
                <Polygon Points="12,3 7,15 12,12 17,15" Fill="#DC2626"/>
                <TextBlock Text="N"
                           FontSize="8"
                           FontWeight="Black"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,-1"/>
            </Grid>
        </Button>

        <!-- 3. Geolocation (Locate Me) -->
        <Button Command="{Binding LocateMeCommand}"
                Width="42" Height="42" Margin="0,0,0,10" Cursor="Hand" ToolTip="Pusatkan ke Lokasi Saya">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FFFFFF"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="21" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <!-- GPS Crosshairs Icon -->
                    <Path Stroke="#0F172A" StrokeThickness="2" StrokeStartLineCap="Round"
                          Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm0-6v3m0 16v3M2 12h3m16 0h3"/>
                </Canvas>
            </Viewbox>
        </Button>

        <!-- 4. Combined Zoom In (+) & Zoom Out (-) Pill -->
        <Border Width="42" Height="84" Margin="0,0,0,10"
                Background="#FFFFFF" CornerRadius="21">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.12" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Zoom In Button -->
                <Button Grid.Row="0"
                        Command="{Binding ZoomInCommand}"
                        Cursor="Hand" ToolTip="Perbesar (Zoom In)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="21,21,0,0" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Thin Divider Line -->
                <Rectangle Grid.Row="1" Fill="#E2E8F0" Margin="8,0"/>

                <!-- Zoom Out Button -->
                <Button Grid.Row="2"
                        Command="{Binding ZoomOutCommand}"
                        Cursor="Hand" ToolTip="Perkecil (Zoom Out)">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="0,0,21,21" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="−" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- 5. Layer Switcher (Dark Forest Green Pill) -->
        <Button Command="{Binding ToggleLayersCommand}"
                Width="42" Height="42" Cursor="Hand" ToolTip="Pilih Lapisan Peta / Satelit">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#0C2523"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="21" Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" Color="#000000"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#173B38"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <!-- Layer Stack Icon -->
                    <Path Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                          Data="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </Canvas>
            </Viewbox>
        </Button>

    </StackPanel>
</UserControl>
