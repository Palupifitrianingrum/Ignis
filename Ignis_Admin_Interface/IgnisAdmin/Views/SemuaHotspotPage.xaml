<UserControl x:Class="IgnisAdmin.Views.SemuaHotspotPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16,8"><TextBlock Text="Admin" FontWeight="Medium"/></Border>
            <TextBlock Style="{StaticResource H1}" Text="Semua Hotspot"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18,8,18,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Daerah"/><ComboBox x:Name="CmbRegion" DisplayMemberPath="Name"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Sumber"/><ComboBox x:Name="CmbSrc"><ComboBoxItem>Semua sumber</ComboBoxItem><ComboBoxItem>Satelit</ComboBoxItem><ComboBoxItem>Manual</ComboBoxItem></ComboBox></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Style="{StaticResource Lbl}" Text="Status"/><ComboBox x:Name="CmbStatus"><ComboBoxItem>Semua status</ComboBoxItem><ComboBoxItem>Aktif</ComboBoxItem><ComboBoxItem>Dipantau</ComboBoxItem><ComboBoxItem>Selesai</ComboBoxItem></ComboBox></StackPanel>
                <Button Grid.Column="3" Content="Terapkan" Style="{StaticResource Btn}" VerticalAlignment="Bottom" Margin="0,0,0,10" Click="Apply_Click"/>
            </Grid>
        </Border>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnPrev" Content="Sebelumnya" Style="{StaticResource BtnSmall}" Click="Prev_Click"/>
                        <Button x:Name="BtnNext" Content="Berikutnya" Style="{StaticResource BtnSmall}" Margin="6,0,0,0" Click="Next_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPage" Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid x:Name="GridHotspots">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Koordinat" Binding="{Binding CoordText}" Width="*"/>
                        <DataGridTextColumn Header="Waktu Deteksi" Binding="{Binding DetectedText}" Width="160"/>
                        <DataGridTextColumn Header="Sumber" Binding="{Binding SourceText}" Width="80" ElementStyle="{StaticResource SourceTag}"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="90"/>
                        <DataGridTextColumn Header="Brightness" Binding="{Binding BrightnessText}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="80"/>
                        <DataGridTemplateColumn Header="Aksi" Width="90">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Detail" Style="{StaticResource BtnSmall}" Click="Detail_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
