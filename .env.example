# Salin ke .env (sudah di-gitignore). Jangan commit nilai asli.
# Dibaca oleh Ignis.Api (dicari dari folder kerja naik ke folder induk) dan docker-compose.yml.

# --- PostgreSQL ---
IGNIS_DB_PASSWORD=ganti_dengan_password_kuat
# InMemory (default: data demo, hilang saat server berhenti) atau Postgres
Storage__Provider=Postgres
ConnectionStrings__Ignis=Host=localhost;Port=5432;Database=ignis;Username=ignis;Password=ganti_dengan_password_kuat
# Buat tabel dan sequence Id otomatis bila belum ada
Storage__AutoCreate=true
# Isi data contoh bila tabel masih kosong. Akun demo (admin@ignis.example dst.) memakai password Ignis@123.
# JANGAN true di server sungguhan.
Storage__SeedDemoData=true

# --- Autentikasi ---
# Kunci penanda tangan token JWT, minimal 32 karakter acak. Buat dengan:
#   powershell:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Kosong = kunci acak sementara (semua pengguna harus login ulang tiap server restart).
Jwt__Key=
# Admin pertama untuk server tanpa data demo (dibuat sekali bila emailnya belum ada). Password minimal 8 karakter.
Admin__Email=
Admin__Password=
Admin__Name=Administrator

# --- Login Google (opsional; cara membuatnya: docs/google-oauth.md) ---
Google__ClientId=
Google__ClientSecret=

# --- Integrasi data eksternal (opsional; cara mendapatkan key: docs/integrasi-data.md) ---
# NASA FIRMS (hotspot satelit). Kosong = sinkronisasi hotspot dilewati.
Integrations__FirmsKey=
# OpenWeather (cuaca nyata). Kosong = cuaca memakai data simulasi.
Integrations__WeatherKey=
# Alternatif untuk key OpenWeather (dipakai bila Integrations__WeatherKey kosong):
OPENWEATHER_API_KEY=
# Pengaturan lanjutan (nilai default sudah wajar; hapus tanda # untuk mengubah):
# Integrations__FirmsSources=VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT
# Integrations__FirmsArea=94,-11,141,6
# Integrations__FirmsDayRange=2
# Integrations__FirmsMaxRows=3000
# Integrations__WeatherMaxAgeMinutes=60
# Integrations__RetryCount=2
# Integrations__RetryDelaySeconds=3
# Folder penyimpanan kunci enkripsi override API key (wajib di Docker/Linux; arahkan ke volume yang disimpan):
# DataProtection__KeysPath=/var/ignis/keys
# Sinkronisasi hotspot otomatis tiap N jam (mati secara default):
# Sync__Enabled=true
# Sync__IntervalHours=1
