<Window x:Class="Ignis.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ignis.Frontend"
        xmlns:dashboard="clr-namespace:Ignis.Frontend.Views.Dashboard"
        mc:Ignorable="d"
        Title="IGNIS - Wildfire Monitoring &amp; Prediction"
        Height="820" Width="1280"
        MinHeight="680" MinWidth="1024"
        Background="#D8EEDC"
        WindowStartupLocation="CenterScreen">

    <!-- Unified Dashboard Grid with Full Canvas and Overlay Drawer Sidebar -->
    <Grid Background="#D8EEDC">

        <!-- Layer 1: Map Canvas (Leaflet Placeholder Canvas) -->
        <dashboard:MapCanvasPlaceholder/>

        <!-- Layer 2: Sample Hotspot Markers & Hazard Cluster Overlay -->
        <dashboard:HotspotBadgesOverlay/>

        <!-- Layer 3: Interactive Floating UI Overlays -->
        <Grid Margin="32,16,20,20">
            <Grid.RowDefinitions>
                <!-- Top Floating Area -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer / Center Map View -->
                <RowDefinition Height="*"/>
                <!-- Bottom Floating Widgets Area -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TOP FLOATING BAR -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Search Bar & Filter Chips -->
                <dashboard:TopSearchBar Grid.Column="0" HorizontalAlignment="Left"/>

                <!-- Right: Emergency Alert Badge + User Profile -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">

                    <!-- Emergency Alert Badge (Siaga Darurat Riau) -->
                    <Border Background="#FFF1EB"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="18"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Megaphone icon -->
                            <Viewbox Width="15" Height="15" Margin="0,0,6,0">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="#EA580C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round"
                                          Data="M3 11l19-9-9 19-2-8-8-2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding EmergencyStatus}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#C2410C"/>
                        </StackPanel>
                    </Border>

                    <!-- User Profile (Captain R. Miller) -->
                    <Button Command="{Binding OpenLoginCommand}"
                            Cursor="Hand"
                            ToolTip="Profil Pengguna &amp; Autentikasi"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="20" Background="{TemplateBinding Background}" Padding="4">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- User Name and Role text -->
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding UserName}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding UserRole}"
                                           FontSize="10"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>

                            <!-- User Avatar Photo with circular clip -->
                            <Border Width="38" Height="38" CornerRadius="19"
                                    BorderBrush="#FFFFFF" BorderThickness="2"
                                    ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <Image Source="/Resources/Icons/captain_miller.jpg"
                                       Stretch="UniformToFill"/>
                            </Border>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!-- BOTTOM FLOATING WIDGETS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Bottom-Left Fire Index & Wind Simulation Card -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <!-- Bottom-Right Floating Map Tool Controls -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bottom-Left: Fire Risk Index Card -->
                <dashboard:FireRiskCard Grid.Column="0" VerticalAlignment="Bottom"/>

                <!-- Bottom-Right: Map Control Buttons Stack -->
                <dashboard:MapControlsOverlay Grid.Column="2" VerticalAlignment="Bottom"/>
            </Grid>

        </Grid>

        <!-- Layer 4: Auto-Hide Slide-Out Sidebar (Tucked to left wall, reveals on hover) -->
        <dashboard:SidebarNav Panel.ZIndex="100"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"/>

    </Grid>
</Window>
