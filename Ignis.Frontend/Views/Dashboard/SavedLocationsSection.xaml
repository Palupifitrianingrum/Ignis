<UserControl x:Class="Ignis.Frontend.Views.Dashboard.SavedLocationsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Tombol teks kecil di kartu lokasi (sidebar gelap) -->
        <Style x:Key="SideTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddLocationButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#F28A1E" CornerRadius="10" Padding="10,3">
                            <TextBlock Text="+ Tambah" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F59E0B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- Akun pengguna terdaftar: daftar lokasi tersimpan -->
        <StackPanel Margin="0,0,0,18" Visibility="{Binding CanUseSavedLocations, Converter={StaticResource B2V}}">
            <Grid Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Command="{Binding ToggleSavedLocationsCommand}"
                        Cursor="Hand"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,8,0"
                        ToolTip="Klik untuk buka/tutup daftar lokasi tersimpan">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#133633"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,7">
                                            <Grid>
                                                <TextBlock Text="LOKASI SAYA"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="chevron"
                                                           Text="▸"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#FBBF24"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1A4541"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSavedLocationsExpanded}" Value="True">
                                                <Setter TargetName="chevron" Property="Text" Value="▾"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource AddLocationButton}" Command="{Binding AddLocationCommand}" VerticalAlignment="Center"
                        ToolTip="Simpan lokasi rumah/kantor untuk diberi tahu bila api atau asap mendekat"/>
            </Grid>

            <StackPanel Visibility="{Binding IsSavedLocationsExpanded, Converter={StaticResource B2V}}">
                <TextBlock Text="Belum ada lokasi. Tambahkan rumah Anda agar diberi tahu bila simulasi memperkirakan api atau asap mendekat."
                           Visibility="{Binding HasNoSavedLocations, Converter={StaticResource B2V}}"
                           FontSize="11" Foreground="#8FB5AF" TextWrapping="Wrap" Margin="2,0,2,4"/>

                <ItemsControl ItemsSource="{Binding SavedLocations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#133633" CornerRadius="10" Padding="11,9" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                                    <Border Background="#DC2626" CornerRadius="8" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasUnread, Converter={StaticResource B2V}}">
                                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFF">
                                            <Run Text="{Binding UnreadCount, Mode=OneWay}"/><Run Text=" baru"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#8FB5AF" Margin="0,2,0,0"/>

                                <!-- Dampak simulasi yang sedang dilihat -->
                                <Grid Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource B2V}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusColorHex}" VerticalAlignment="Top" Margin="0,4,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="#E2E8F0" TextWrapping="Wrap"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Lihat" Style="{StaticResource SideTextButton}"
                                            Command="{Binding DataContext.FocusLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Ubah" Style="{StaticResource SideTextButton}" Margin="12,0,0,0"
                                            Command="{Binding DataContext.EditLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Hapus" Style="{StaticResource SideTextButton}" Margin="12,0,0,0" Foreground="#FCA5A5"
                                            Command="{Binding DataContext.DeleteLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
