<Window x:Class="IgnisAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ignis Admin" Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        FontFamily="Poppins, Segoe UI" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Dark}" Padding="16,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                    <Canvas Width="30" Height="36">
                        <Path Fill="{StaticResource Orange}" Data="M16,1 C19,8 27,11 27,21 A12,12 0 0 1 3,21 C3,15 7,12 10,9 C10,13 12,15 14,15 C13,10 13,6 16,1 Z"/>
                        <Path Fill="{StaticResource Green}" Data="M3,22 A12,12 0 0 0 27,22 C22,26 13,27 3,22 Z"/>
                    </Canvas>
                    <TextBlock Text="IGNIS" Foreground="#F6F4EF" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton x:Name="NavDashboard" Style="{StaticResource Nav}" GroupName="nav" Tag="Dashboard" Content="Dashboard" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Kelola" Content="Kelola Hotspot" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Semua" Content="Semua Hotspot" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Manual" Content="Hotspot Manual" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Pengguna" Content="Manajemen Pengguna" Checked="Nav_Checked"/>
                <Rectangle Height="1" Fill="#2B5C52" Margin="0,12"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Riwayat" Content="Riwayat Prediksi" Checked="Nav_Checked"/>
                <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="Pengaturan" Content="Pengaturan" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border x:Name="Banner" Visibility="Collapsed" Background="{StaticResource Orange}" Padding="32,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tutup" Style="{StaticResource BtnSmall}" Click="CloseBanner_Click"/>
                    <TextBlock x:Name="BannerText" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Host" Grid.Row="1" IsTabStop="False"/>
        </Grid>
    </Grid>
</Window>
